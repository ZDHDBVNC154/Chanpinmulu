---
import { env } from 'cloudflare:workers';
import AdminLayout from '../../layouts/AdminLayout.astro';
import { countAllProducts } from '../../features/products/db';
import { listCategories } from '../../features/categories/db';
import { countInquiries, listInquiries } from '../../features/inquiries/db';

if (!Astro.locals.settings?.setupComplete) return Astro.redirect('/admin/setup', 302);
const [productCount, categories, inquiryCount, newCount, recent] = await Promise.all([
  countAllProducts(env.DB), listCategories(env.DB), countInquiries(env.DB), countInquiries(env.DB, 'new'), listInquiries(env.DB, 6),
]);
const cards = [
  { label: '产品', value: productCount, href: '/admin/products' },
  { label: '分类', value: categories.length, href: '/admin/categories' },
  { label: '全部询价', value: inquiryCount, href: '/admin/inquiries' },
  { label: '新询价', value: newCount, href: '/admin/inquiries?status=new' },
];
---

<AdminLayout title="概览" active="dashboard">
  <div class="mb-8 flex items-end justify-between gap-4"><div><p class="text-xs tracking-widest text-gray-400">CHRISTMAS CATALOG</p><h1 class="mt-2 font-serif text-3xl tracking-tight">产品目录概览</h1></div><a href="/admin/products/new" class="rounded-md bg-brand px-4 py-2 text-xs font-medium tracking-wider text-white hover:bg-brand-hover">新增产品</a></div>
  <div class="mb-12 grid grid-cols-2 gap-4 sm:grid-cols-4">{cards.map((card) => <a href={card.href} class="rounded-lg border border-line p-5 transition hover:border-brand"><p class="text-xs tracking-widest text-gray-400">{card.label}</p><p class="mt-2 font-serif text-3xl tabular-nums">{card.value}</p></a>)}</div>
  <section>
    <div class="mb-3 flex items-baseline justify-between"><h2 class="text-xs tracking-widest text-gray-400">最近询价</h2><a href="/admin/inquiries" class="text-xs tracking-widest text-accent hover:underline">查看全部</a></div>
    <div class="overflow-x-auto"><table class="admin-table w-full text-left text-sm"><thead><tr class="border-b border-line text-xs text-gray-400"><th class="py-3 pr-4 font-normal">编号</th><th class="py-3 pr-4 font-normal">公司</th><th class="py-3 pr-4 font-normal">国家/地区</th><th class="py-3 pr-4 font-normal">产品数</th><th class="py-3 font-normal">状态</th></tr></thead><tbody>{recent.map((inquiry) => <tr class="border-b border-line"><td class="py-3 pr-4"><a href={`/admin/inquiries/${inquiry.public_id}`} class="text-accent hover:underline">{inquiry.reference}</a></td><td class="py-3 pr-4">{inquiry.company}</td><td class="py-3 pr-4 text-gray-500">{inquiry.country}</td><td class="py-3 pr-4 tabular-nums">{inquiry.item_count ?? 0}</td><td class="py-3">{inquiry.status === 'new' ? '新询价' : inquiry.status}</td></tr>)}{recent.length === 0 && <tr><td colspan="5" class="py-10 text-center text-gray-400">还没有询价单。</td></tr>}</tbody></table></div>
  </section>
</AdminLayout>

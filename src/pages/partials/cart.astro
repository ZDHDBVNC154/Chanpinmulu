---
import { env } from 'cloudflare:workers';
import { readCart, resolveCart, cartCount, CART_QTY_MAX } from '../../features/cart/cart';
import ProductImage from '../../features/products/ProductImage.astro';
import { getSetting } from '../../features/settings/db';

export const partial = true;
export const prerender = false;

const cart = readCart(Astro.cookies);
const [{ lines }, imageDeliverySetting] = await Promise.all([resolveCart(env.DB, cart), getSetting(env.DB, 'image_delivery')]);
const imageDelivery = imageDeliverySetting === 'cloudflare' ? 'cloudflare' : 'original';
---

<div data-cart-count={cartCount(cart)}>
  {lines.length === 0 ? (
    <p class="py-10 text-center text-sm text-muted">Your Quote Basket is empty.</p>
  ) : (
    <Fragment>
      <ul class="divide-y divide-line">
        {lines.map((line) => (
          <li class="flex gap-4 py-4">
            <a href={`/products/${line.product.slug}`} class="shrink-0"><ProductImage imageKey={line.product.image_key} alt="" sizes="64px" fade usage="thumbnail" delivery={imageDelivery} class="h-16 w-16 rounded object-cover" /></a>
            <div class="min-w-0 flex-1">
              <a href={`/products/${line.product.slug}`} class="block truncate text-sm font-medium hover:text-brand">{line.product.name}</a>
              {line.product.sku && <span class="mt-0.5 block text-xs text-faint">SKU {line.product.sku}</span>}
              <span class="mt-0.5 block text-xs text-muted">MOQ {line.product.moq ?? 1} pcs</span>
              <div class="mt-2 flex flex-wrap items-center gap-3">
                <form method="POST" action="/api/cart" class="flex items-center gap-2">
                  <input type="hidden" name="_action" value="update" /><input type="hidden" name="key" value={line.key} />
                  <input type="number" name="qty" min={line.product.moq ?? 1} max={CART_QTY_MAX} value={line.qty} aria-label="Quantity" class="w-24 rounded border border-line bg-transparent px-2 py-1 text-center text-sm tabular-nums focus:border-brand focus:outline-none" />
                  <button type="submit" class="text-xs uppercase tracking-wider text-brand">Update</button>
                </form>
                <form method="POST" action="/api/cart"><input type="hidden" name="_action" value="remove" /><input type="hidden" name="key" value={line.key} /><button type="submit" class="text-xs uppercase tracking-wider text-faint hover:text-red-600">Remove</button></form>
              </div>
            </div>
          </li>
        ))}
      </ul>
      <a href="/cart" class="mt-6 block w-full rounded-md bg-brand px-6 py-3 text-center text-sm font-medium uppercase tracking-wider text-on-brand hover:bg-brand-hover">Review &amp; send inquiry</a>
    </Fragment>
  )}
</div>

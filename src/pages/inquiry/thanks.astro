---
import Layout from '../../layouts/Layout.astro';
const reference = Astro.url.searchParams.get('ref');
---

<Layout title="Inquiry received" description="Your product inquiry has been received.">
  <div class="mx-auto max-w-2xl py-16 text-center">
    <p class="text-xs uppercase tracking-[0.25em] text-brand">Thank you</p>
    <h1 class="mt-3 font-serif text-4xl tracking-tight">Your inquiry has been received</h1>
    <p class="mt-5 text-muted">Our export team will review the requested products and contact you by email.</p>
    {reference && <p class="mt-6 rounded-lg border border-line bg-surface px-4 py-3 font-mono text-sm">Reference: {reference}</p>}
    <a href="/products" class="mt-8 inline-block rounded-md bg-brand px-6 py-3 text-sm font-medium uppercase tracking-wider text-white">Continue browsing</a>
  </div>
</Layout>

<script>
  // The next inquiry should record its own first-touch campaign, not reuse the
  // source that led to this completed submission.
  try {
    localStorage.removeItem('auromai_first_touch');
  } catch {
    // Restricted browsing may disable storage.
  }
</script>

---
import { env } from 'cloudflare:workers';
import Layout from '../layouts/Layout.astro';
import { readCart, resolveCart, CART_QTY_MAX } from '../features/cart/cart';
import ProductImage from '../features/products/ProductImage.astro';
import Turnstile from '../features/auth/Turnstile.astro';
import { catalogPath } from '../features/settings/home';

if (!(Astro.locals.settings?.cartEnabled ?? true)) return Astro.redirect('/', 302);

const { lines } = await resolveCart(env.DB, readCart(Astro.cookies));
const error = Astro.url.searchParams.get('error');
const catalogHref = catalogPath(Astro.locals.settings?.homePage);
---

<Layout title="Request a quotation" description="Send your wholesale Christmas product inquiry to our factory.">
  <div class="mx-auto max-w-5xl">
    <div class="mb-10 max-w-2xl">
      <p class="text-xs uppercase tracking-[0.28em] text-brand">Wholesale inquiry</p>
      <h1 class="mt-3 font-serif text-4xl tracking-tight sm:text-5xl">Request a quotation</h1>
      <p class="mt-4 text-muted">Confirm the products and quantities below. Our export team will reply with pricing, sampling details and the earliest production schedule.</p>
    </div>

    {error && <p class="mb-8 rounded-md border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-900">{error}</p>}

    {lines.length === 0 ? (
      <div class="rounded-xl border border-line bg-surface px-6 py-12 text-center">
        <p class="text-muted">Your Quote Basket is empty.</p>
        <a href={catalogHref} class="mt-5 inline-block rounded-md bg-brand px-6 py-3 text-sm font-medium text-on-brand hover:bg-brand-hover">Browse products</a>
      </div>
    ) : (
      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.25fr)_minmax(320px,.75fr)]">
        <section aria-labelledby="inquiry-products-heading">
          <div class="mb-4 flex items-end justify-between gap-4">
            <h2 id="inquiry-products-heading" class="font-serif text-2xl">Products</h2>
            <a href={catalogHref} class="text-sm text-brand hover:underline">Add more products</a>
          </div>
          <ul class="divide-y divide-line border-y border-line">
            {lines.map((line) => (
              <li class="flex flex-wrap gap-4 py-5">
                <a href={`/products/${line.product.slug}`} class="shrink-0">
                  <ProductImage imageKey={line.product.image_key} alt="" usage="thumbnail" fade sizes="80px" class="h-20 w-20 rounded-md object-cover" />
                </a>
                <div class="min-w-0 flex-1">
                  <a href={`/products/${line.product.slug}`} class="font-medium hover:text-brand">{line.product.name}</a>
                  {line.product.sku && <p class="mt-1 text-xs uppercase tracking-wider text-faint">SKU {line.product.sku}</p>}
                  {(line.variant || line.extras.length > 0) && <p class="mt-1 text-xs text-muted">{[line.variant?.label, ...line.extras.map((extra) => extra.label)].filter(Boolean).join(' · ')}</p>}
                  <p class="mt-1 text-xs text-muted">MOQ: {line.product.moq ?? 1} pcs</p>
                  <div class="mt-3 flex flex-wrap items-center gap-4">
                    <form method="POST" action="/api/cart" class="flex items-center gap-2">
                      <input type="hidden" name="_action" value="update" /><input type="hidden" name="key" value={line.key} />
                      <label class="text-xs uppercase tracking-widest text-muted" for={`qty-${line.key}`}>Quantity</label>
                      <input id={`qty-${line.key}`} type="number" name="qty" min={line.product.moq ?? 1} max={CART_QTY_MAX} value={line.qty} class="w-28 rounded-md border border-line bg-paper px-3 py-2 text-sm tabular-nums focus:border-brand focus:outline-none" />
                      <button type="submit" class="text-xs uppercase tracking-widest text-brand hover:underline">Update</button>
                    </form>
                    <form method="POST" action="/api/cart"><input type="hidden" name="_action" value="remove" /><input type="hidden" name="key" value={line.key} /><button type="submit" class="text-xs uppercase tracking-widest text-faint hover:text-red-600">Remove</button></form>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </section>

        <section class="rounded-xl border border-line bg-surface p-6" aria-labelledby="contact-heading">
          <h2 id="contact-heading" class="font-serif text-2xl">Your contact details</h2>
          <form method="POST" action="/api/inquiries" data-inquiry-form class="mt-6 space-y-4">
            <div class="hidden" aria-hidden="true"><label>Website <input name="website" tabindex="-1" autocomplete="off" /></label></div>
            <input type="hidden" name="browser_timezone" />
            <input type="hidden" name="landing_url" />
            <input type="hidden" name="referrer" />
            <input type="hidden" name="utm_source" />
            <input type="hidden" name="utm_medium" />
            <input type="hidden" name="utm_campaign" />
            <label class="block text-sm">Name <span class="text-red-600">*</span><input required name="contact_name" autocomplete="name" maxlength="120" class="mt-1.5 w-full rounded-md border border-line bg-paper px-3 py-2.5 focus:border-brand focus:outline-none" /></label>
            <label class="block text-sm">Company <span class="text-red-600">*</span><input required name="company" autocomplete="organization" maxlength="180" class="mt-1.5 w-full rounded-md border border-line bg-paper px-3 py-2.5 focus:border-brand focus:outline-none" /></label>
            <label class="block text-sm">Business email <span class="text-red-600">*</span><input required type="email" name="email" autocomplete="email" maxlength="254" class="mt-1.5 w-full rounded-md border border-line bg-paper px-3 py-2.5 focus:border-brand focus:outline-none" /></label>
            <label class="block text-sm">Phone / WhatsApp<input name="phone" autocomplete="tel" maxlength="120" class="mt-1.5 w-full rounded-md border border-line bg-paper px-3 py-2.5 focus:border-brand focus:outline-none" /></label>
            <label class="block text-sm">Country / region <span class="text-red-600">*</span><input required name="country" autocomplete="country-name" maxlength="120" class="mt-1.5 w-full rounded-md border border-line bg-paper px-3 py-2.5 focus:border-brand focus:outline-none" /></label>
            <label class="block text-sm">Target delivery date<input name="target_delivery" placeholder="e.g. August 2027" maxlength="120" class="mt-1.5 w-full rounded-md border border-line bg-paper px-3 py-2.5 focus:border-brand focus:outline-none" /></label>
            <label class="block text-sm">Requirements<textarea name="message" rows="4" maxlength="3000" placeholder="Colors, packaging, logo, target market..." class="mt-1.5 w-full rounded-md border border-line bg-paper px-3 py-2.5 focus:border-brand focus:outline-none"></textarea></label>
            <Turnstile />
            <button type="submit" class="w-full rounded-md bg-brand px-6 py-3 text-sm font-medium uppercase tracking-wider text-on-brand hover:bg-brand-hover">Send inquiry</button>
            <p class="text-xs leading-relaxed text-faint">No payment is collected. This is a quotation request only.</p>
          </form>
        </section>
      </div>
    )}
  </div>
</Layout>

<script>
  const inquiryForm = document.querySelector<HTMLFormElement>('[data-inquiry-form]');
  if (inquiryForm) {
    const setField = (name: string, value: unknown) => {
      const field = inquiryForm.elements.namedItem(name);
      if (field instanceof HTMLInputElement) field.value = typeof value === 'string' ? value : '';
    };
    try {
      const attribution = JSON.parse(localStorage.getItem('auromai_first_touch') || '{}');
      for (const name of ['landing_url', 'referrer', 'utm_source', 'utm_medium', 'utm_campaign']) {
        setField(name, attribution[name]);
      }
    } catch {
      // Storage may be disabled; the inquiry still submits normally.
    }
    setField('browser_timezone', Intl.DateTimeFormat().resolvedOptions().timeZone);
  }
</script>

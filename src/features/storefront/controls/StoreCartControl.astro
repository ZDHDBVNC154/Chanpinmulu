---
/**
 * The header cart link and its live count badge.
 *
 * Owns two hooks the document shell's enhancement script depends on:
 * `data-cart-open` (intercepted to open the drawer instead of navigating) and
 * `data-cart-count-label` (where the badge text is written). The script fails
 * soft when they are missing, so losing them breaks the drawer silently —
 * which is why they live here and not in an editable file.
 *
 * The drawer markup itself stays in the document shell, beside that script.
 */
interface Props {
  href: string;
  class?: string;
}

const { href, class: className = 'inline-flex items-center hover:text-brand' } = Astro.props;
---

<a href={href} data-cart-open class={className}>
  <svg
    aria-hidden="true"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    class="mr-2 h-5 w-5"
  >
    <path stroke-linecap="round" stroke-linejoin="round" d="M3 4h2l2.1 9.2a2 2 0 0 0 2 1.6h7.8a2 2 0 0 0 1.9-1.4L21 7H6" />
    <circle cx="10" cy="19" r="1.2" />
    <circle cx="18" cy="19" r="1.2" />
  </svg>
  Quote Basket
  <span
    data-cart-count-label
    class="inline-block min-w-[4ch] tabular-nums"
    aria-live="polite"
    aria-atomic="true"
  />
</a>

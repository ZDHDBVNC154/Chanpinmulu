---
import { getConfig } from '../config';
import '../styles/admin.css';

type Section = 'dashboard' | 'products' | 'categories' | 'inquiries' | 'imports' | 'media' | 'pages' | 'navigation' | 'settings' | 'orders' | 'customers' | 'shipping';
interface Props { title?: string; active?: Section; }
const { title, active } = Astro.props;
const storeName = Astro.locals.settings?.storeName ?? getConfig().storeName;
const showSetupNudge = !Astro.locals.settings?.setupComplete && Astro.url.pathname !== '/admin/setup';
const showLogout = !!Astro.cookies.get('admin_session')?.value;
const pageTitle = title ? `${title} — ${storeName} 后台` : `${storeName} 后台`;
const nav: { key: Section; label: string; href: string }[] = [
  { key: 'dashboard', label: '概览', href: '/admin' },
  { key: 'products', label: '产品', href: '/admin/products' },
  { key: 'categories', label: '分类', href: '/admin/categories' },
  { key: 'inquiries', label: '询价单', href: '/admin/inquiries' },
  { key: 'imports', label: '批量导入', href: '/admin/imports' },
  { key: 'media', label: '图片库', href: '/admin/media' },
  { key: 'pages', label: '页面', href: '/admin/pages' },
  { key: 'navigation', label: '导航', href: '/admin/navigation' },
  { key: 'settings', label: '设置', href: '/admin/settings' },
];
const currentLabel = nav.find((item) => item.key === active)?.label ?? '菜单';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen bg-paper text-ink antialiased">
    <div class="mx-auto flex max-w-6xl flex-col gap-8 px-6 py-8 sm:flex-row sm:gap-10">
      <aside class="w-full shrink-0 sm:w-52 sm:border-r sm:border-line sm:pr-6">
        <a href="/admin" class="mb-4 block font-serif text-xl tracking-tight sm:mb-8">{storeName}</a>
        <input type="checkbox" id="admin-nav" data-admin-nav-toggle class="peer sr-only" aria-label="打开后台菜单" />
        <label for="admin-nav" data-admin-nav-summary class="flex cursor-pointer select-none items-center justify-between gap-3 rounded-md border border-line bg-white/60 px-4 py-3 sm:hidden"><span><span class="block text-[0.625rem] uppercase tracking-[0.25em] text-gray-400">后台管理</span><span class="font-serif text-lg">{currentLabel}</span></span><span aria-hidden="true">⌄</span></label>
        <nav data-admin-nav-list class="mt-2 hidden overflow-hidden rounded-md border border-line bg-white/60 text-xs tracking-widest peer-checked:block sm:mt-0 sm:block sm:space-y-0.5 sm:rounded-none sm:border-0 sm:bg-transparent">
          {nav.map((item) => <a href={item.href} aria-current={active === item.key ? 'page' : undefined} class={`flex items-center justify-between border-b border-l-2 border-line px-4 py-3 transition last:border-b-0 sm:block sm:border-b-0 sm:px-3 sm:py-2 ${active === item.key ? 'border-l-brand bg-paper font-medium text-brand sm:bg-transparent' : 'border-l-transparent text-gray-500 hover:text-brand'}`}><span>{item.label}</span>{active === item.key && <span aria-hidden="true" class="size-1.5 rounded-full bg-brand sm:hidden" />}</a>)}
        </nav>
        <div class="mt-5 flex gap-4 text-xs tracking-widest text-gray-400 sm:mt-8 sm:flex-col sm:gap-2"><a href="/" class="hover:text-brand">&larr; 查看目录</a>{showLogout && <a href="/admin/logout" class="hover:text-brand">退出登录</a>}</div>
      </aside>
      <main class="min-w-0 flex-1">
        {showSetupNudge && <a href="/admin/setup" class="mb-6 flex items-center justify-between gap-3 rounded-md border border-brand/30 bg-brand/5 px-4 py-3 text-sm text-gray-700"><span><strong class="font-semibold">完成首次设置</strong> — 设置工厂名称和后台密码。</span><span aria-hidden="true" class="text-brand">&rarr;</span></a>}
        <slot />
      </main>
    </div>
  </body>
</html>

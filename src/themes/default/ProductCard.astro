---
import type { ProductCardModel } from '../../features/storefront/models';
import StoreImage from '../../features/storefront/controls/StoreImage.astro';

interface Props { card: ProductCardModel; index?: number; headingLevel?: 'h2' | 'h3'; }
const { card, index = 0, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<li class="reveal group" style={`animation-delay:${Math.min(index, 8) * 60}ms`}>
  <a href={card.href} class="block">
    <div class="relative overflow-hidden rounded-md bg-surface">
      <StoreImage image={card.image} fade class={`aspect-square w-full object-cover transition-transform duration-500 ease-out group-hover:scale-[1.04]${card.inStock ? '' : ' opacity-60'}`} />
      {card.isNew && <span class="absolute left-3 top-3 rounded-full bg-brand px-3 py-1 text-[11px] uppercase tracking-widest text-on-brand">New</span>}
      {!card.inStock && <span class="absolute right-3 top-3 rounded-full bg-surface/90 px-2.5 py-0.5 text-xs uppercase tracking-widest text-muted ring-1 ring-line">Sold out</span>}
    </div>
    {card.sku && <p class="mt-4 text-[11px] uppercase tracking-[0.18em] text-faint">SKU {card.sku}</p>}
    <Heading class={card.sku ? 'mt-1 text-sm font-medium tracking-tight' : 'mt-4 text-sm font-medium tracking-tight'}>{card.name}</Heading>
    <div class="mt-2 flex flex-wrap items-center justify-between gap-2 text-xs text-muted">
      <span>MOQ {card.moq ?? 1} pcs</span>
      <span class="text-brand">{card.showPrice !== false ? card.formattedPrice : 'Request quotation'}</span>
    </div>
  </a>
</li>

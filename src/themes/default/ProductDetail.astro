---
import type { ProductDetailModel, ProductPurchaseModel } from '../../features/storefront/models';
import ProductCard from './ProductCard.astro';
import ProductGallery from '../../features/storefront/controls/ProductGallery.astro';
import ProductPurchaseForm from '../../features/storefront/controls/ProductPurchaseForm.astro';

interface Props { model: ProductDetailModel; purchase: ProductPurchaseModel; }
const { model, purchase } = Astro.props;
---

<a href={model.backHref} class="text-xs uppercase tracking-widest text-faint hover:text-brand">&larr; Back to catalog</a>
{model.error && <p class="mt-4 rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-800">{model.error}</p>}

<div class="mt-6 grid gap-10 md:grid-cols-2 md:gap-16">
  <ProductGallery images={model.images} hero={model.heroImage} soldOut={false} class="reveal" />
  <div class="reveal flex flex-col" style="animation-delay:90ms">
    {model.categories.length > 0 && <div class="mb-4 flex flex-wrap gap-x-4 gap-y-1 text-xs uppercase tracking-widest text-faint">{model.categories.map((category) => <a href={category.href} class="hover:text-brand">{category.text}</a>)}</div>}
    {model.sku && <p class="mb-2 text-xs uppercase tracking-[0.2em] text-faint">SKU {model.sku}</p>}
    <h1 class="font-serif text-4xl tracking-tight">{model.name}</h1>
    {model.nameZh && <p class="mt-2 text-sm text-muted">{model.nameZh}</p>}
    <div class="mt-6 flex flex-wrap gap-3">
      <span class="rounded-full border border-line px-3 py-1.5 text-xs text-muted">MOQ {model.moq ?? 1} pcs</span>
      {model.oemAvailable !== false && <span class="rounded-full border border-line px-3 py-1.5 text-xs text-muted">OEM / ODM available</span>}
    </div>
    {model.showPrice !== false ? (
      <p class="mt-5 text-lg text-brand" data-price-display data-base={model.priceCents} data-currency={model.currency}>{model.priceVaries && <span class="text-base text-faint">from </span>}{model.formattedPrice}</p>
    ) : (
      <p class="mt-5 text-lg text-brand">Contact us for wholesale pricing</p>
    )}
    {model.lowStock && <p data-low-stock class="mt-2 text-sm text-amber-700">Low stock</p>}
    {model.descriptionHtml && <div class="markdown-content mt-6 max-w-prose text-muted" set:html={model.descriptionHtml} />}

    {model.specifications && model.specifications.length > 0 && (
      <div class="mt-8 overflow-hidden rounded-lg border border-line">
        <h2 class="border-b border-line bg-surface px-4 py-3 text-xs uppercase tracking-[0.2em] text-muted">Product specifications</h2>
        <dl>{model.specifications.map((specification) => <div class="grid grid-cols-[9rem_1fr] gap-4 border-b border-line px-4 py-3 text-sm last:border-b-0"><dt class="text-muted">{specification.label}</dt><dd>{specification.value}</dd></div>)}</dl>
      </div>
    )}

    <ProductPurchaseForm model={purchase} />
  </div>
</div>

{model.related.length > 0 && <section class="mt-20 border-t border-line pt-12"><h2 class="mb-8 text-xs uppercase tracking-[0.25em] text-faint">Related products</h2><ul class="grid grid-cols-2 gap-x-6 gap-y-12 lg:grid-cols-4">{model.related.map((card, index) => <ProductCard card={card} index={index} headingLevel="h3" />)}</ul></section>}
